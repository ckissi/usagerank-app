# Copy to .env.signing (gitignored) and fill in. Used by scripts/release-mac.sh.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# App Store Connect API key (Users and Access > Integrations > Team Keys, role: Developer)
APPLE_API_KEY=ABC123DEFG
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8"

# Or, instead of the API key: Apple ID + app-specific password (appleid.apple.com)
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234
